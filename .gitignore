# Files and directories created by pub
.dart_tool/
.packages

# Pubspec overrides
pubspec_overrides.yaml
# The workspace root's overrides file is committed (see pubspec.yaml).
!/pubspec_overrides.yaml

# Agents: the skills and MCP configs of Claude Code (.claude/, .mcp.json),
# Codex (.codex/, .agents/), Cursor (.cursor/) and Antigravity (.agents/) are
# committed so a fresh checkout is ready for agentic coding. Only the skills
# manager's cache and per-machine settings stay out.
.dart_skills/
.claude/settings.local.json
.claude/worktrees/
.gemini/
.vscode/mcp.json

# Serverpod Cloud CLI
.scloud/

# Build outputs
build/
# ...but not source folders named build (wonky_sheets_script/lib/src/build/).
!**/lib/**/build/
